# Firebase Configuration (From Firebase Console > Project settings > General)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Google Sign-In Configuration (OAuth 2.0 Web Client ID from Google Cloud Console / Firebase)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# RevenueCat Public SDK API Keys (From RevenueCat Dashboard > Project Settings > API Keys)
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=goog_your_revenuecat_google_public_key
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=appl_your_revenuecat_apple_public_key
